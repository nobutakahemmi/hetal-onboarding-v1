# Origin used in the canonical URL and the future Indeed <url>.
# No path, query, or hash. Example: https://jobs.example.com
PUBLIC_BASE_URL=http://localhost:3000

# Apply link template. Must be http(s) and include the {referencenumber} token.
# This is a placeholder, not a live AppsFlyer OneLink.
APPSFLYER_ONELINK_TEMPLATE=https://example.onelink.me/abcd?pid=indeed&c={referencenumber}

# Optional. Defaults to 3000.
PORT=3000
